{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/fixtures.ts",
    "src/cli.ts",
    "src/import-cli.ts"
  ]
}
