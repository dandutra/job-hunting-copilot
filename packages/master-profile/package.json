{
  "name": "master-profile",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample:check": "tsx src/cli.ts sample/master-profile.yaml",
    "profile:check": "tsx src/cli.ts ../../data/master-profile.yaml",
    "check": "pnpm build && pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm sample:check",
    "profile:import": "tsx src/import-cli.ts ../../data/master-profile.yaml"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "types": "dist/index.d.ts"
}
