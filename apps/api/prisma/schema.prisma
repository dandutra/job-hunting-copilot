datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        Int            @id @default(autoincrement())
  name      String
  // A Watched company has both; the pair is the board we poll.
  ats       String?
  boardSlug String?        @map("board_slug")
  aliases   CompanyAlias[]
  postings  Posting[]

  @@unique([ats, boardSlug])
  @@map("company")
}

model CompanyAlias {
  id             Int     @id @default(autoincrement())
  companyId      Int     @map("company_id")
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String  @unique @map("normalized_name")

  @@index([companyId])
  @@map("company_alias")
}

model Posting {
  id              Int              @id @default(autoincrement())
  companyId       Int              @map("company_id")
  company         Company          @relation(fields: [companyId], references: [id])
  title           String
  location        String
  description     String
  // full, snippet or none
  descriptionKind String           @map("description_kind")
  // The earliest Sighting's reportedAt.
  postedAt        DateTime         @map("posted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  sightings       Sighting[]
  mergeLog        MergeLogEntry[]
  tailoredResumes TailoredResume[]
  jevJudgements   JevJudgement[]

  @@index([companyId])
  @@map("posting")
}

model Sighting {
  id               Int             @id @default(autoincrement())
  postingId        Int             @map("posting_id")
  posting          Posting         @relation(fields: [postingId], references: [id], onDelete: Cascade)
  jobSource        String          @map("job_source")
  listingKey       String          @map("listing_key")
  // The ATS listing key that an Indeed job_url_direct parses to.
  directKey        String?         @map("direct_key")
  url              String
  reportedAt       DateTime        @map("reported_at")
  companyId        Int             @map("company_id")
  companyName      String          @map("company_name")
  title            String
  location         String
  description      String
  descriptionKind  String          @map("description_kind")
  directUrl        String?         @map("direct_url")
  watchedCompanyId Int?            @map("watched_company_id")
  firstSeenAt      DateTime        @map("first_seen_at")
  lastSeenAt       DateTime        @map("last_seen_at")
  // Set when a complete board listing stops showing this Sighting; the matcher clears it on a new report.
  closedAt         DateTime?       @map("closed_at")
  mergeLog         MergeLogEntry[]

  // No unique key: a repost after 30 quiet days reuses the key on a new Posting.
  @@index([jobSource, listingKey])
  @@index([listingKey])
  @@index([directKey])
  @@index([postingId])
  @@index([lastSeenAt])
  @@index([watchedCompanyId])
  @@map("sighting")
}

model MergeLogEntry {
  id                Int       @id @default(autoincrement())
  // shared_listing_key or direct_url; the review screen filters on it.
  rule              String
  evidence          Json
  postingId         Int       @map("posting_id")
  posting           Posting   @relation(fields: [postingId], references: [id], onDelete: Cascade)
  // The Sighting that joined, or null when a whole Posting was absorbed.
  sightingId        Int?      @map("sighting_id")
  sighting          Sighting? @relation(fields: [sightingId], references: [id], onDelete: SetNull)
  absorbedPostingId Int?      @map("absorbed_posting_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([rule])
  @@index([postingId])
  @@map("merge_log_entry")
}

// lastPollAt is where each adapter's next window starts, so a restart or a long outage still covers the gap.
// lastAttemptAt (any outcome) paces an adapter with a long minIntervalMs, so a failure is not retried every tick.
model IngestCursor {
  adapter       String    @id
  lastPollAt    DateTime? @map("last_poll_at")
  lastAttemptAt DateTime? @map("last_attempt_at")

  @@map("ingest_cursor")
}

// Never updated or deleted: data/ is gitignored, so these rows are the profile's only history.
model MasterProfileVersion {
  id              String           @id
  rawYaml         String           @map("raw_yaml")
  createdAt       DateTime         @default(now()) @map("created_at")
  tailoredResumes TailoredResume[]
  jevJudgements   JevJudgement[]

  @@map("master_profile_version")
}

// The draft JSON is never updated after the insert; only status and the review fields change.
model TailoredResume {
  id               Int                  @id @default(autoincrement())
  postingId        Int                  @map("posting_id")
  // Restrict: a merge must move drafts, never delete them with the absorbed Posting.
  posting          Posting              @relation(fields: [postingId], references: [id], onDelete: Restrict)
  profileVersionId String               @map("profile_version_id")
  profileVersion   MasterProfileVersion @relation(fields: [profileVersionId], references: [id])
  status           String
  // Without the pasted Posting text, so the Claim review can read the draft as is.
  draft            Json
  postingText      String?              @map("posting_text")
  verdicts         Json?
  rejectNote       String?              @map("reject_note")
  rejectLines      Json?                @map("reject_lines")
  createdAt        DateTime             @default(now()) @map("created_at")
  approvedAt       DateTime?            @map("approved_at")

  @@index([postingId, status])
  @@map("tailored_resume")
}

// Never updated or deleted: tuning reads these rows, so it needs no second Jev call. The newest row per Posting is live.
model JevJudgement {
  id                 Int                  @id @default(autoincrement())
  // Restrict: a merge must move judgements, never delete them with the absorbed Posting.
  postingId          Int                  @map("posting_id")
  posting            Posting              @relation(fields: [postingId], references: [id], onDelete: Restrict)
  profileVersionId   String               @map("profile_version_id")
  profileVersion     MasterProfileVersion @relation(fields: [profileVersionId], references: [id])
  questionSetVersion String               @map("question_set_version")
  // What the Posting's description was when asked; a move from none or snippet to full triggers a rerun.
  descriptionKind    String               @map("description_kind")
  // The model ID Jev returned, not the one we asked for.
  model              String
  answers            Json
  inputTokens        Int?                 @map("input_tokens")
  outputTokens       Int?                 @map("output_tokens")
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([postingId, createdAt])
  @@index([profileVersionId])
  @@map("jev_judgement")
}
