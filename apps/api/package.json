{
  "name": "api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --entryFile main --env-file ../../.env",
    "dev:ingest": "nest start --watch --entryFile main.ingest --env-file ../../.env",
    "dev:all": "pnpm run dev & pnpm run dev:ingest & wait",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "seed": "prisma db seed",
    "jev:sample": "tsx scripts/jev-sample.ts",
    "generate:spec": "ts-node --transpile-only -O '{\"rootDir\":\".\"}' scripts/write-openapi.ts",
    "generate:types": "openapi-typescript ../jobspy/openapi.json -o src/ingestion/jobspy/schema.d.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@typesafe-ai/sdk": "0.7.0",
    "master-profile": "workspace:*",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
