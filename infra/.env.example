# Copy to infra/.env (gitignored, mode 600). Load it with: set -a; source infra/.env; set +a
DIGITALOCEAN_TOKEN=
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=
# B2 key for the Terraform provider: all buckets, read and write.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# These two names belong to the AWS SDK inside Terraform's S3 backend. They hold the
# B2 state key (state bucket only). No AWS account is involved.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Name of the B2 backups bucket Terraform creates (must be unique across B2).
TF_VAR_backups_bucket_name=
