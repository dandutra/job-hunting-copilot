# Copy to .env. No real values here.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://copilot:change-me@localhost:5432/copilot
API_PORT=3000
JOBSPY_URL=http://localhost:8000
JOBSPY_PORT=8000
VITE_API_URL=http://localhost:3000

# Production (deploy/compose.prod.yaml). Compose builds DATABASE_URL and JOBSPY_URL itself.
# Keep POSTGRES_PASSWORD free of URL-special characters (@ : / ? #), because it goes into DATABASE_URL.
# IMAGE_TAG is a commit SHA, set by CI; there is no `latest`.
IMAGE_TAG=0000000000000000000000000000000000000000
