# Copy to .env. No real values here.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://copilot:change-me@localhost:5432/copilot
API_PORT=3000
JOBSPY_URL=http://localhost:8000
JOBSPY_PORT=8000
# Comma-separated user:pass@host:port list for JobSpy's proxies. Empty means a direct connection.
JOBSPY_PROXIES=
# What the ingest process asks JobSpy to search for, on LinkedIn and Indeed. Both are optional.
JOBSPY_SEARCH_TERM=software developer
JOBSPY_LOCATION=Toronto, ON
JOBSPY_RESULTS_WANTED=50
VITE_API_URL=http://localhost:3000

# Production (deploy/compose.prod.yaml). Compose builds DATABASE_URL and JOBSPY_URL itself.
# Keep POSTGRES_PASSWORD free of URL-special characters (@ : / ? #), because it goes into DATABASE_URL.
# IMAGE_TAG is a commit SHA, set by CI; there is no `latest`.
IMAGE_TAG=0000000000000000000000000000000000000000

# The API answers only requests whose Tailscale-User-Login equals this, and refuses to start if it is empty.
ALLOWED_TAILSCALE_LOGIN=

# Where `pnpm profile:import` sends data/master-profile.yaml: the app's tailnet address, no trailing slash.
# The Mac's Tailscale identity authorises it. Leave empty here; the real value is not committed.
COPILOT_API_URL=
